#!/usr/bin/env python3
"""uwccctl — command line control for the open-uniwill-cc service.

Usage: uwccctl [--json] COMMAND [ARGS]       uwccctl help [COMMAND]       Linux: man uwccctl

Overview
  status                         mode, fans, temperatures, battery, liquid cooler, settings
  monitor [--watch [SEC]]        sensors once, or every SEC seconds (default 2) until Ctrl+C
  mode [office|gaming|turbo|custom]
  profile [N]                    show / select the profile slot of the current mode (from 0)
  profile show|set|reset [TARGET] ...   PL1/PL2/PL4, TCC, cTGP, Dynamic Boost, GPU limit, name
  boost [on|off]                 FanBoost (fans at maximum)
  super [on|off]                 super performance (overclocking fan table and GPU limits)
  ramoc [on|off]                 RAM overclocking (BIOS, applies after a reboot)
  fan list|show|set|separate|reset ...   fan tables
  battery [mode|limit|typec] ... battery protection mode, charge limits, Type-C priority
  kb [on|off|effects|effect|level] ...   keyboard backlight
  lb [hinge|base|logo] on|off|color|effect|light ...   light bar
  clevo ...                      Control Center 3.0 / Clevo (experimental, separate module): see uwccctl help clevo
  get [KEY]  /  set KEY VALUE    switches and automation (see: uwccctl help set)
  apps [add|remove|enable|disable] ...   switch the mode when a program runs
  restore --yes                  factory profiles and fan tables
  lc ...                         liquid cooler (Bluetooth): status, scan, connect, mode, manual, tiers, ...
  history [csv|csv-excel|json] [1m|5m|15m|1h|24h] [FILE]
  export fans|all FILE  /  import FILE [fans,profiles,settings] [--force]
  report [FILE] [--private serial,uuid,mac,names,apps] [--sections ...] [--full]
  lang en|ru  /  debug on|off  /  version  /  update [check|install]  /  restart
  ec [use auto|oem|wmi] [--accept-risks]   EC Manager (Windows): OEM driver / WMI (beta); same as `driver`
  ec unlock [MIN] | lock         administrator unlock of the EC Manager settings (run as administrator / sudo)
  ec fetch-driver | check-driver | install-driver [--accept-risks]   OEM driver for the free build
  driver-verify DIR              check an OEM driver package (no service needed)
  ec config export|import FILE|reset  /  ec test  /  ec monitor oem|wmi|all on|off
  ec platform [export FILE|import FILE|reset|apply-draft]  /  ec selfcheck [1|2] [--export FILE]
  lighting  /  nvram  /  ec read ADDR  /  resume
  ec-direct read ADDR [N] | dump BASE    (root, without the service)
  release                        give fan control back to the EC (root, used by uninstall)

--json prints machine-readable output (one JSON document; monitor --watch prints one per line).
Exit codes: 0 success, 1 the service rejected the request, 2 wrong usage, 3 the service is
unavailable or access is denied.
"""
import json
import locale
import os
import sys
import time
