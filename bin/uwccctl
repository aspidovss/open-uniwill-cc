#!/usr/bin/env python3
"""Command line control for the Control Center service.

  uwccctl status                 current mode, fans, settings, liquid cooler
  uwccctl mode office|gaming|turbo|custom
  uwccctl profile <N>            profile of the current mode (0..2; RamFan1p5 platforms: 0..1, custom slots 0..4)
  uwccctl boost on|off           FanBoost
  uwccctl kb off|on|effect N     keyboard backlight
  uwccctl lb [hinge|base|logo] on|off|color RRGGBB [EFFECT]|effect static|breathing|wave|rainbow|...|light 0-4
  uwccctl lighting               keyboard / light bar devices (diagnostics)
  uwccctl history [csv|csv-excel|json] [1m|5m|15m|1h|24h] [FILE]   sensor history (default 1h; stdout or FILE)
  uwccctl debug on|off           verbose service log (for bug reports)
  uwccctl version                version of the service and the latest release
  uwccctl restart                restart the service (Linux: systemctl, group uwcc; Windows: administrator console)
  uwccctl update [check|install] check GitHub for a new release (install: Windows only)
  uwccctl report [FILE] [--private serial,uuid,mac,names,apps] [--sections system,ec,...] [--full]
                                 diagnostic report (zip) for adding support / bug reports;
                                 --full adds the original Control Center folders complete (large)
  uwccctl export fans|all FILE   fan tables / full backup (profiles, settings, liquid cooler) to FILE
  uwccctl import FILE [fans,profiles,settings] [--force]   default: fans,profiles; --force ignores another project
  uwccctl lang en|ru             interface language (UI, notifications, this tool)
  uwccctl lc status              liquid cooler (Bluetooth)
  uwccctl lc scan                find coolers nearby
  uwccctl lc connect ADDR        connect and remember (reconnects automatically)
  uwccctl lc disconnect [--forget]
  uwccctl lc mode auto|ec|low|medium|high|off
  uwccctl lc manual FAN% PUMP_V  e.g. uwccctl lc manual 60 8   (pump 7/8/11/12 V, 0 = off)
  uwccctl lc rgb RRGGBB [static|breathe|rainbow|breathe_rainbow|spiral|rotating_rainbow|color_wave]
  uwccctl lc rgb off
  uwccctl lc prime [stop]        coolant filling cycle (~68 s)
  uwccctl lc suspend             put the cooler to sleep (used by the system-sleep hook)
  uwccctl ec read ADDR           read an EC register through the service (hex address)
  uwccctl nvram                  dump UniWillVariable fields
  uwccctl resume                 re-apply settings (used by the system-sleep hook)
  uwccctl ec-direct read ADDR    read EC without the service (root, for debugging)
  uwccctl release                give fan control back to the EC, clear AP flags (root, used by uninstall)
"""
import json
import locale
import os
import sys
import time
import urllib.error
import urllib.request

PORT = int(os.environ.get("UWCC_PORT", "47321"))
IS_WIN = sys.platform == "win32"
TOKEN_FILE = (os.path.join(os.environ.get("ProgramData", r"C:\ProgramData"), "UWCC", "run", "token") if IS_WIN
              else "/run/uwcc/token")
MODES = {"office": 0, "gaming": 1, "turbo": 2, "custom": 3}

TEXT = {
    "en": {
        "no_access": "No access to the service: log out and in again after installation (group uwcc) or run: sudo uwccctl ...",
        "not_running": "The service is not running: sudo systemctl start uwccd  (log: journalctl -u uwccd -b)",
        "no_access_win": "No access to the service token (C:\\ProgramData\\UWCC\\run\\token). Reinstall Control Center.",
        "not_running_win": "The service is not running: sc start uwccd  (log: C:\\ProgramData\\UWCC\\log\\uwccd.log)",
        "error": "error",
        "project": "Project:", "mode": "Mode:", "table": "table", "fans": "Fans:", "cpu": "CPU", "gpu": "GPU",
        "temp": "Temperature:", "battery": "Battery:", "bat_line": "protection mode {}, limit {}–{}%, {} cycles",
        "settings": "Settings:", "modes": {0: "Office", 1: "Gaming", 2: "Turbo", 3: "Custom"}, "rpm": "rpm",
        "lc": "Liquid cooler:", "lc_na": "unavailable (install python3-bleak)", "lc_none": "not connected",
        "lc_off": "disconnected", "lc_saved": "remembered: {}", "lc_fan": "fan", "lc_pump": "pump",
        "lc_pump_off": "pump off", "lc_flow": "flow", "lc_mode": "mode", "lc_found": "Found:", "lc_nothing":
        "No cooler found. Is it powered on and is Bluetooth enabled?",
        "flow": {"ok": "OK", "fault": "NO FLOW", "starting": "starting", "unknown": "unknown", "idle": "—", "priming": "filling"},
        "lang_set": "Language: English",
    },
    "ru": {
        "no_access": "Нет доступа к службе: войдите в сеанс заново после установки (группа uwcc) или выполните: sudo uwccctl ...",
        "not_running": "Служба не запущена: sudo systemctl start uwccd  (журнал: journalctl -u uwccd -b)",
        "no_access_win": "Нет доступа к ключу службы (C:\\ProgramData\\UWCC\\run\\token). Переустановите Control Center.",
        "not_running_win": "Служба не запущена: sc start uwccd  (журнал: C:\\ProgramData\\UWCC\\log\\uwccd.log)",
        "error": "ошибка",
        "project": "Проект:", "mode": "Режим:", "table": "таблица", "fans": "Вентиляторы:", "cpu": "ЦП", "gpu": "ГП",
        "temp": "Температура:", "battery": "Батарея:", "bat_line": "режим защиты {}, предел {}–{}%, циклов {}",
        "settings": "Настройки:", "modes": {0: "Офисный", 1: "Игровой", 2: "Турбо", 3: "Пользовательский"}, "rpm": "об/мин",
        "lc": "Водяное охлаждение:", "lc_na": "недоступно (установите python3-bleak)", "lc_none": "не подключено",
        "lc_off": "отключено", "lc_saved": "запомнено: {}", "lc_fan": "вентилятор", "lc_pump": "помпа",
        "lc_pump_off": "помпа выкл", "lc_flow": "поток", "lc_mode": "режим", "lc_found": "Найдено:", "lc_nothing":
        "Система охлаждения не найдена. Она включена и Bluetooth активен?",
        "flow": {"ok": "норма", "fault": "НЕТ ПОТОКА", "starting": "запуск", "unknown": "неизвестно", "idle": "—", "priming": "заполнение"},
        "lang_set": "Язык: русский",
    },
}
LANG = "en"


def T(k):
    return TEXT[LANG].get(k, TEXT["en"].get(k, k))


def guess_lang():
    loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or (locale.getlocale()[0] or "")
    return "ru" if loc.lower().startswith("ru") else "en"


def tok():
    global LANG
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip()
    except PermissionError:
        LANG = guess_lang()
        sys.exit(T("no_access_win" if IS_WIN else "no_access"))
    except FileNotFoundError:
        LANG = guess_lang()
        sys.exit(T("not_running_win" if IS_WIN else "not_running"))


def call_raw(path, timeout=30):
    req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/{path}", headers={"X-UWCC-Token": tok()})
    try:
        return urllib.request.urlopen(req, timeout=timeout).read()
    except urllib.error.HTTPError as e:
        sys.exit(f"{T('error')}: {json.load(e).get('error', e)}")
    except urllib.error.URLError:
        sys.exit(T("not_running_win" if IS_WIN else "not_running"))


def call(path, body=None, method=None, timeout=30):
    req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/{path}", method=method or ("POST" if body is not None else "GET"),
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"X-UWCC-Token": tok(), "Content-Type": "application/json"})
    try:
        return json.load(urllib.request.urlopen(req, timeout=timeout))
    except urllib.error.HTTPError as e:
        sys.exit(f"{T('error')}: {json.load(e).get('error', e)}")
    except urllib.error.URLError:
        sys.exit(T("not_running_win" if IS_WIN else "not_running"))


def _pkg():
    try:
        import uwccd  # noqa: F401  # pyflakes: ignore  (bundled in the Windows build)
    except ImportError:
        sys.path.insert(0, "/opt/uwcc")


def direct_ec():
    _pkg()
    from uwccd.ec import open_ec
    return open_ec()


def lc_line(lc):
    if not lc["available"]:
        return T("lc_na")
    if not lc["connected"]:
        saved = lc["config"].get("name") or lc["config"].get("address")
        return T("lc_none") + (", " + T("lc_saved").format(saved) if saved else "") + \
            (f" ({lc['error']})" if lc.get("error") else "")
    pump = f"{T('lc_pump')} {lc['pump']} V" if lc["pump"] else T("lc_pump_off")
    return (f"{lc['name']} fw {lc['fw'] or '?'} · {T('lc_mode')} {lc['config']['mode']} · "
            f"{T('lc_fan')} {lc['fan']}% · {pump} · {T('lc_flow')}: {T('flow').get(lc['flow'], lc['flow'])}")


def cmd_lc(a):
    op = a[0] if a else "status"
    if op == "status":
        print(T("lc"), lc_line(call("state")["liquid"]))
    elif op == "scan":
        devs = call("lc/scan", {}, timeout=40)["devices"]
        if not devs:
            print(T("lc_nothing"))
        for d in devs:
            print(f"  {d['address']}  {d['name']}  RSSI {d['rssi']}")
    elif op == "connect":
        call("lc/connect", {"address": a[1]}, timeout=70)
        print(T("lc"), lc_line(call("state")["liquid"]))
    elif op == "disconnect":
        call("lc/disconnect", {"forget": "--forget" in a})
    elif op == "mode":
        call("lc/config", {"mode": a[1]})
    elif op == "manual":
        call("lc/config", {"mode": "manual", "fan": int(a[1]), "pump": int(a[2])})
    elif op == "rgb":
        if a[1] == "off":
            call("lc/config", {"rgb": {"on": False}})
        else:
            h = a[1].lstrip("#")
            rgb = {"on": True, "color": [int(h[i:i + 2], 16) for i in (0, 2, 4)]}
            if len(a) > 2:
                rgb["mode"] = a[2].replace("-", "_")
            call("lc/config", {"rgb": rgb})
    elif op == "prime":
        call("lc/prime", {"stop": len(a) > 1 and a[1] == "stop"})
    elif op == "suspend":
        call("lc/suspend", {})
    else:
        sys.exit(__doc__)


def main(a):
    global LANG
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd = a[0]
    if cmd == "restart":
        import subprocess
        if IS_WIN:
            subprocess.run(["sc.exe", "stop", "uwccd"], check=False)
            time.sleep(3)
            sys.exit(subprocess.run(["sc.exe", "start", "uwccd"], check=False).returncode)
        sys.exit(subprocess.run(["systemctl", "restart", "uwccd.service"], check=False).returncode)
    if cmd not in ("ec-direct", "release"):
        LANG = call("state")["settings"].get("lang", "en") if cmd in ("status", "lc", "lang") else LANG
    if cmd == "status":
        s = call("state")
        m = call("monitor")
        p = s["power"]
        print(f"{T('project'):15} {s['platform']['project_name']}  (EC: {s['platform']['ec_backend']})")
        prof = s["profiles"].get(p.get("current_profile") or "", {})
        slot = f" «{prof.get('CustomizeName')}»" if p["mode"] == 3 else ""
        print(f"{T('mode'):15} {T('modes').get(p['mode'])}{slot}  {T('table')} {p['current_table']}  "
              f"FanBoost={'on' if p['fan_boost'] else 'off'}  [{p.get('manager', 'cml')}]")
        if p.get("manager") == "std" and prof:
            c = prof["CPU"]
            print(f"{'':15} PL1/PL2/PL4 {c['PL1']}/{c['PL2']}/{c['PL4']} W" +
                  (f", TCC −{c['TccOffset']} °C" if c.get("TccOffsetSwitch") else ""))
        print(f"{T('fans'):15} {T('cpu')} {m['fans']['cpu_duty']}% {m['fans']['cpu_rpm']} {T('rpm')}" +
              (f", {T('gpu')} {m['fans']['gpu_duty']}% {m['fans']['gpu_rpm']} {T('rpm')}" if 'gpu_duty' in m['fans'] else ""))
        print(f"{T('temp'):15} {T('cpu')} {m['cpu']['temp'] if m['cpu']['temp'] is not None else '—'}°C" + (f", {T('gpu')} {m['gpu']['temp']}°C" if m.get('gpu') else ""))
        b = s["battery"]
        print(f"{T('battery'):15} " + T("bat_line").format(b['health_mode'], b['limit_down'], b['limit_up'], b['cycle_count']))
        print(f"{T('lc'):15} {lc_line(s['liquid'])}")
        print(f"{T('settings'):15} " + ", ".join(f"{k}={v}" for k, v in s["settings"].items()))
    elif cmd == "lang":
        if a[1:] and a[1] in ("en", "ru"):
            call("setting", {"key": "lang", "value": a[1]})
            LANG = a[1]
        print(T("lang_set"))
    elif cmd == "lb":
        zones = ("hinge", "base", "logo")
        rest = a[1:]
        zone = rest.pop(0) if rest and rest[0] in zones else "hinge"
        op = rest[0] if rest else "status"
        if op in ("on", "off"):
            call("lightbar", {"zone": zone, "power": op == "on"})
        elif op == "color" and rest[1:]:
            x = rest[1].lstrip("#")
            call("lightbar", {"zone": zone, "colors": [[int(x[i:i + 2], 16) for i in (0, 2, 4)]],
                              **({"effect": rest[2]} if rest[2:] else {})})
        elif op == "effect" and rest[1:]:
            call("lightbar", {"zone": zone, "effect": rest[1]})
        elif op == "light" and rest[1:]:
            call("lightbar", {"zone": zone, "light": int(rest[1])})
        lb = call("state")["keyboard"].get("lightbar")
        print(json.dumps(lb, indent=2, ensure_ascii=False) if lb else "no light bar")
    elif cmd == "lighting":
        print(json.dumps(call("lighting/devices"), indent=2, ensure_ascii=False))
    elif cmd == "history":
        ranges = ("1m", "5m", "15m", "1h", "24h")
        fmt = next((x for x in a[1:] if x in ("csv", "csv-excel", "json")), "csv")
        rng = next((x for x in a[1:] if x in ranges), "1h")
        out = next((x for x in a[1:] if x not in ("csv", "csv-excel", "json") + ranges), None)
        data = call_raw(f"history/export?format={fmt}&range={rng}")
        if out:
            with open(out, "wb") as f:
                f.write(data)
            print(out)
        else:
            sys.stdout.write(data.decode("utf-8-sig"))
    elif cmd in ("version", "update"):
        st = call("update/check", {}, timeout=40) if cmd == "update" or a[1:2] == ["check"] else call("update")
        print("open-uniwill-cc", st.get("version_full") or st.get("current"))
        if st.get("error"):
            print("update check:", st["error"])
        elif st.get("latest"):
            print("latest release:", st["latest"], "— newer, see " + str(st.get("url")) if st.get("newer") else "(up to date)")
        if cmd == "update" and a[1:2] == ["install"]:
            if not st.get("can_install"):
                sys.exit("Linux: download the release archive and run: sudo bash install.sh")
            call("update/download", {})
            print("downloading; the Control Center tray app starts the installer when it is verified")
        elif st.get("newer") and not IS_WIN:
            print("install: download " + str(st.get("linux") or st.get("url")) + ", unpack it and run: sudo bash install.sh")
    elif cmd == "report":
        opt = lambda k: next((a[i + 1] for i, x in enumerate(a) if x == k and i + 1 < len(a)), "")   # noqa: E731
        flags = {"--private", "--sections"}
        out = next((x for i, x in enumerate(a[1:], 1) if not x.startswith("--") and a[i - 1] not in flags), None)
        q = f"report?private={opt('--private')}" + (f"&sections={opt('--sections')}" if opt("--sections") else "") \
            + ("&full=1" if "--full" in a else "")
        req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/{q}", headers={"X-UWCC-Token": tok()})
        try:
            r = urllib.request.urlopen(req, timeout=180)
        except urllib.error.HTTPError as e:
            sys.exit(f"{T('error')}: {json.load(e).get('error', e)}")
        except urllib.error.URLError:
            sys.exit(T("not_running_win" if IS_WIN else "not_running"))
        name = out or r.headers.get("X-UWCC-Filename") or "uwcc-report.zip"
        with open(name, "wb") as f:
            f.write(r.read())
        print(os.path.abspath(name))
        print("Attach it to a GitHub issue (https://github.com/aspidovss/open-uniwill-cc/issues) "
              "or send it to OUCC@aspidov.ru")
    elif cmd == "export":
        what = a[1] if a[1:] and a[1] in ("fans", "all") else sys.exit("uwccctl export fans|all FILE")
        data = call_raw(f"export?what={what}")
        if a[2:]:
            with open(a[2], "wb") as f:
                f.write(data)
            print(a[2])
        else:
            sys.stdout.write(data.decode())
    elif cmd == "import":
        if not a[1:]:
            sys.exit("uwccctl import FILE [fans,profiles,settings] [--force]")
        with open(a[1], encoding="utf-8-sig") as f:
            data = json.load(f)
        rest = [x for x in a[2:] if x != "--force"]
        sections = rest[0].split(",") if rest else ["fans", "profiles"]
        r = call("import", {"data": data, "sections": sections, "force": "--force" in a})
        print(json.dumps(r, indent=2, ensure_ascii=False))
    elif cmd == "debug":
        if a[1:] and a[1] in ("on", "off"):
            call("setting", {"key": "debug", "value": a[1] == "on"})
        print("debug logging:", "on" if call("state")["settings"].get("debug") else "off")
    elif cmd == "lc":
        cmd_lc(a[1:])
    elif cmd == "mode":
        call("mode", {"mode": MODES[a[1]]})
    elif cmd == "profile":
        mode = call("state")["power"]["mode"]
        call("profile", {"mode": mode, "index": int(a[1])})
    elif cmd == "boost":
        call("fanboost", {"on": a[1] == "on"})
    elif cmd == "kb":
        if a[1] in ("on", "off"):
            call("keyboard/power", {"on": a[1] == "on"})
        elif a[1] == "effect":
            call("keyboard/effect", {"effect": int(a[2])})
    elif cmd == "ec" and a[1] == "read":
        r = call(f"ec/{int(a[2], 16):x}")
        print(f"0x{r['addr']:04X} = 0x{r['value']:02X} ({r['value']})")
    elif cmd == "nvram":
        print(json.dumps(call("nvram"), indent=1))
    elif cmd == "resume":
        call("resume", {})
    elif cmd == "ec-direct":
        ec = direct_ec()
        if a[1] == "read":
            addr = int(a[2], 16)
            n = int(a[3]) if len(a) > 3 else 1
            for i in range(n):
                print(f"0x{addr + i:04X} = 0x{ec.read(addr + i):02X}")
        elif a[1] == "dump":
            base = int(a[2], 16)
            for row in range(0, 256, 16):
                print(f"{base + row:04X}: " + " ".join(f"{ec.read(base + row + i):02X}" for i in range(16)))
    elif cmd == "release":
        _pkg()
        from uwccd.nvram import Nvram
        ec = direct_ec()
        ec.set_bit(0x7C6, 2, False)   # RAM fan table off
        ec.set_bit(0x741, 0, False)   # AP not present
        nv = Nvram()
        nv.verify(ec.read(0x740))
        nv.set("ApExistFlag", 0)
        if nv.get("MemoryOverClockSupport") == 1 and nv.get("MemoryOverClockSwitch"):
            nv.set("MemoryOverClockSwitch", 0)     # SetFwVarsForUninstall: no RAM overclocking without the program
            print("RAM overclocking switched off (BIOS, next start)")
        print("fan control returned to the EC")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
