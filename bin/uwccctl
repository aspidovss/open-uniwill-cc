def T(k):
    return TEXT[LANG].get(k, TEXT["en"].get(k, k))


def guess_lang():
    loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or (locale.getlocale()[0] or "")
    return "ru" if loc.lower().startswith("ru") else "en"


def fail(msg, code=1):
    """Error: text on stderr, or {"error": ...} on stdout with --json."""
    if JSON:
        msg = str(msg)
        for pre in (TEXT["en"]["error"] + ": ", TEXT["ru"]["error"] + ": "):
            msg = msg[len(pre):] if msg.startswith(pre) else msg
        print(json.dumps({"error": msg}, ensure_ascii=False))
    else:
        print(msg, file=sys.stderr)
    sys.exit(code)


HELP["ec"] = ("uwccctl ec read ADDR                      one EC register through the service (hex)\n"
              + HELP["driver"].replace("uwccctl driver", "uwccctl ec    "))


def usage(topic):
    fail(HELP.get(topic, __doc__), 2)


def out(data, text=None):
    """Result: JSON with --json, otherwise `text` (str, list of lines or a callable)."""
    if JSON:
        print(json.dumps(data, ensure_ascii=False, indent=1))
        return
    if callable(text):
        text = text(data)
    if text is None:
        text = json.dumps(data, ensure_ascii=False, indent=2)
    print("\n".join(text) if isinstance(text, list) else text)


def tok():
    global LANG
    if os.environ.get("UWCC_TOKEN"):
        return os.environ["UWCC_TOKEN"]
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip()
    except PermissionError:
        LANG = guess_lang()
        fail(T("no_access_win" if IS_WIN else "no_access"), 3)
    except FileNotFoundError:
        LANG = guess_lang()
        fail(T("not_running_win" if IS_WIN else "not_running"), 3)


def admin_tok():
    """The administrator key (readable only by administrators / root): sent along when available."""
    try:
        with open(ADMIN_FILE) as f:
            return f.read().strip()
    except OSError:
        return None


def _headers(extra=None):
    h = {"X-UWCC-Token": tok(), **(extra or {})}
    a = admin_tok()
    if a:
        h["X-UWCC-Admin"] = a
    return h


def _open(req, timeout):
    try:
        return urllib.request.urlopen(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        try:
            msg = json.load(e).get("error", e)
        except ValueError:
            msg = e
        fail(f"{T('error')}: {msg}", 3 if e.code in (401, 403) else 1)
    except (urllib.error.URLError, ConnectionError, TimeoutError):
        fail(T("not_running_win" if IS_WIN else "not_running"), 3)


def call_raw(path, timeout=30):
    req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/{path}", headers=_headers())
    return _open(req, timeout).read()


def call(path, body=None, method=None, timeout=30):
    req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/{path}", method=method or ("POST" if body is not None else "GET"),
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers=_headers({"Content-Type": "application/json"}))
    return json.load(_open(req, timeout))


def _pkg():
    try:
        import uwccd  # noqa: F401  # pyflakes: ignore  (bundled in the Windows build)
    except ImportError:
        sys.path.insert(0, "/opt/uwcc")


def direct_ec():
    _pkg()
    from uwccd.ec import open_ec
    return open_ec()


# -- value parsing ------------------------------------------------------------------------------
def onoff(v, topic):
    v = str(v).lower()
    if v in ON:
        return True
    if v in OFF:
        return False
    usage(topic)


def num(v, topic, kind=int):
    try:
        return kind(v)
    except (TypeError, ValueError):
        usage(topic)


def rgb(x, topic):
    x = x.lstrip("#")
    if len(x) != 6:
        usage(topic)
    try:
        return [int(x[i:i + 2], 16) for i in (0, 2, 4)]
    except ValueError:
        usage(topic)


def hexrgb(c):
    return "%02X%02X%02X" % tuple(c) if c else "—"


def mode_value(v):
    v = str(v).lower()
    if v in ("keep", "previous"):
        return v
    if v in MODES:
        return MODES[v]
    if v.isdigit():
        return int(v)
    usage("set")


def setting_value(key, v):
    kind = SETTINGS.get(key)
    if kind == "bool":
        return onoff(v, "set")
    if kind == "int":
        return num(v, "set")
    if kind == "mode":
        return mode_value(v)
    return v


def opts(args, flags):
    """--key value / --flag options -> (dict, positional)."""
    o, pos, i = {}, [], 0
    while i < len(args):
        x = args[i]
        if x.startswith("--") and x[2:] in flags:
            if flags[x[2:]]:
                if i + 1 >= len(args):
                    return None, None
                o[x[2:]] = args[i + 1]
                i += 1
            else:
                o[x[2:]] = True
        else:
            pos.append(x)
        i += 1
    return o, pos


# -- status ---------------------------------------------------------------------------------------
def lc_line(lc):
    if not lc["available"]:
        return T("lc_na")
    if not lc["connected"]:
        saved = lc["config"].get("name") or lc["config"].get("address")
        return T("lc_none") + (", " + T("lc_saved").format(saved) if saved else "") + \
            (f" ({lc['error']})" if lc.get("error") else "")
    pump = f"{T('lc_pump')} {lc['pump']} V" if lc["pump"] else T("lc_pump_off")
    return (f"{lc['name']} fw {lc['fw'] or '?'} · {T('lc_mode')} {lc['config']['mode']} · "
            f"{T('lc_fan')} {lc['fan']}% · {pump} · {T('lc_flow')}: {T('flow').get(lc['flow'], lc['flow'])}")


def cmd_status():
    s = call("state")
    m = call("monitor")
    if JSON:
        return out({"state": s, "monitor": m})
    p = s["power"]
    print(f"{T('project'):15} {s['platform'].get('display_name') or s['platform']['project_name']}  "
          f"({s['platform']['project_name']}, EC: {s['platform']['ec_backend']})")
    prof = s["profiles"].get(p.get("current_profile") or "", {})
    slot = f" «{prof.get('CustomizeName')}»" if p["mode"] == 3 else ""
    print(f"{T('mode'):15} {T('modes').get(p['mode'])}{slot}  {T('table')} {p['current_table']}  "
          f"FanBoost={'on' if p['fan_boost'] else 'off'}" +
          ("  super=on" if p.get("super_performance") else "") + f"  [{p.get('manager', 'cml')}]")
    if p.get("manager") == "std" and prof:
        c = prof["CPU"]
        print(f"{'':15} PL1/PL2/PL4 {c['PL1']}/{c['PL2']}/{c['PL4']} W" +
              (f", TCC −{c['TccOffset']} °C" if c.get("TccOffsetSwitch") else ""))
    print(f"{T('fans'):15} {T('cpu')} {m['fans']['cpu_duty']}% {m['fans']['cpu_rpm']} {T('rpm')}" +
          (f", {T('gpu')} {m['fans']['gpu_duty']}% {m['fans']['gpu_rpm']} {T('rpm')}" if 'gpu_duty' in m['fans'] else ""))
    print(f"{T('temp'):15} {T('cpu')} {m['cpu']['temp'] if m['cpu']['temp'] is not None else '—'}°C" +
          (f", {T('gpu')} {m['gpu']['temp']}°C" if m.get('gpu') else ""))
    b = s["battery"]
    print(f"{T('battery'):15} " + T("bat_line").format(b['health_mode'], b['limit_down'], b['limit_up'], b['cycle_count']))
    print(f"{T('lc'):15} {lc_line(s['liquid'])}")
    print(f"{T('settings'):15} " + ", ".join(f"{k}={v}" for k, v in s["settings"].items()))


def monitor_line(m):
    def v(x, unit=""):
        return "—" if x is None else f"{x}{unit}"
    c, g, f = m.get("cpu") or {}, m.get("gpu") or {}, m.get("fans") or {}
    s = (time.strftime("%H:%M:%S", time.localtime(m.get("t", time.time()))) +
         f"  CPU {v(c.get('temp'), '°C')} {v(c.get('usage'), '%')} {v(c.get('mhz'), ' MHz')} {v(c.get('power_w'), ' W')}")
    if g:
        s += f"  GPU {v(g.get('temp'), '°C')} {v(g.get('usage'), '%')} {v(g.get('core_mhz') or g.get('mhz'), ' MHz')} {v(g.get('power_w'), ' W')}"
    s += f"  fan CPU {v(f.get('cpu_duty'), '%')} {v(f.get('cpu_rpm'), ' rpm')}"
    if "gpu_duty" in f:
        s += f" GPU {v(f.get('gpu_duty'), '%')} {v(f.get('gpu_rpm'), ' rpm')}"
    mem = m.get("memory") or {}
    s += f"  RAM {v(mem.get('usage'), '%')}"
    bat = m.get("battery") or {}
    if bat.get("present"):
        s += f"  bat {v(bat.get('percent'), '%')}"
    return s + ("  AC" if m.get("ac") else "")


def cmd_monitor(a):
    o, pos = opts(a, {"watch": False})
    if o is None or pos[1:]:
        usage("monitor")
    if not o.get("watch"):
        m = call("monitor")
        return out(m, monitor_line)
    period = max(0.5, num(pos[0], "monitor", float)) if pos else 2.0
    try:
        while True:
            m = call("monitor")
            print(json.dumps(m, ensure_ascii=False) if JSON else monitor_line(m), flush=True)
            time.sleep(period)
    except KeyboardInterrupt:
        pass


# -- modes and profiles ---------------------------------------------------------------------------
def cmd_mode(a):
    if a:
        if a[0] not in MODES:
            usage("mode")
        call("mode", {"mode": MODES[a[0]]})
    p = call("state")["power"]
    out({"mode": MODE_BY_ID.get(p["mode"]), "id": p["mode"], "profile": p.get("current_profile"),
         "table": p.get("current_table")}, lambda d: f"{d['mode']}  ({d['profile']}, {d['table']})")


def profile_target(s, t):
    """MODE | MODE:N | Mode4_Profile5 | None (active) -> profile name."""
    profs, p = s["profiles"], s["power"]
    if not t:
        name = p.get("current_profile")
    elif t in profs:
        name = t
    else:
        mode, _, idx = t.partition(":")
        if mode not in MODE_PREFIX:
            fail(f"{T('error')}: unknown profile {t}", 2)
        if idx:
            i = num(idx, "profile")
        else:
            i = int((p.get("profile_index") or {}).get(mode, 0))
        name = f"Mode{MODE_PREFIX[mode]}_Profile{i + 1}"
    if name not in profs:
        fail(f"{T('error')}: no profile {name} on this laptop", 1)
    return name


def profile_text(name, pr, active):
    c, g, f = pr.get("CPU", {}), pr.get("GPU", {}), pr.get("FAN", {})

    def sw(on, val, unit):
        return f"{val} {unit}" if on else "off"
    return [f"{name}{' (active)' if active else ''}  «{pr.get('CustomizeName', '')}»  table {f.get('TableName')}",
            f"  PL1/PL2/PL4  {c.get('PL1')}/{c.get('PL2')}/{c.get('PL4')} W",
            f"  TCC offset   {sw(c.get('TccOffsetSwitch'), c.get('TccOffset'), '°C')}",
            f"  cTGP         {sw(g.get('ConfigurableTGPSwitch'), g.get('ConfigurableTGPTarget'), 'W')}",
            f"  Dyn. Boost   {sw(g.get('DynamicBoostSwitch'), g.get('DynamicBoost'), 'W')}",
            f"  GPU limit    {sw(g.get('TargetTemperatureSwitch'), g.get('TargetTemperature'), '°C')}",
            f"  fan switch   {sw(f.get('FanSwitchSpeedEnabled'), f.get('FanSwitchSpeed'), 'rpm')}"]


PROFILE_KEYS = {   # key -> (section, value key, switch key)
    "pl1": ("CPU", "PL1", None), "pl2": ("CPU", "PL2", None), "pl4": ("CPU", "PL4", None),
    "tcc": ("CPU", "TccOffset", "TccOffsetSwitch"),
    "ctgp": ("GPU", "ConfigurableTGPTarget", "ConfigurableTGPSwitch"),
    "db": ("GPU", "DynamicBoost", "DynamicBoostSwitch"),
    "gputemp": ("GPU", "TargetTemperature", "TargetTemperatureSwitch"),
    "fanspeed": ("FAN", "FanSwitchSpeed", "FanSwitchSpeedEnabled"),
}


def cmd_profile(a):
    s = call("state")
    p = s["power"]
    op = a[0] if a else "show"
    if op.isdigit():
        mode = p["mode"]
        call("profile", {"mode": mode, "index": int(op)})
        s = call("state")
        op, a = "show", ["show"]
    if op == "list":
        cur = s["power"].get("current_profile")
        rows = {n: {"name": pr.get("CustomizeName"), "table": pr.get("FAN", {}).get("TableName"),
                    "PL1": pr["CPU"].get("PL1"), "PL2": pr["CPU"].get("PL2"), "PL4": pr["CPU"].get("PL4"),
                    "active": n == cur} for n, pr in sorted(s["profiles"].items())}
        return out(rows, lambda d: [f"{'*' if r['active'] else ' '} {n:16} «{r['name']}»  {r['table']}  "
                                    f"PL {r['PL1']}/{r['PL2']}/{r['PL4']} W" for n, r in d.items()])
    if op == "show":
        name = profile_target(s, a[1] if a[1:] else None)
        pr = s["profiles"][name]
        return out(pr, lambda d: profile_text(name, d, name == s["power"].get("current_profile")))
    if op == "reset":
        name = profile_target(s, a[1] if a[1:] else None)
        pr = call(f"profile-reset/{name}", {})
        return out(pr, lambda d: profile_text(name, d, name == s["power"].get("current_profile")))
    if op == "set":
        rest = a[1:]
        target = rest.pop(0) if rest and "=" not in rest[0] else None
        if not rest:
            usage("profile")
        name = profile_target(s, target)
        body = {}
        for kv in rest:
            k, eq, v = kv.partition("=")
            k = k.lower()
            if not eq:
                usage("profile")
            if k == "name":
                body["CustomizeName"] = v
                continue
            if k not in PROFILE_KEYS:
                fail(f"{T('error')}: unknown key {k} (pl1 pl2 pl4 tcc ctgp db gputemp fanspeed name)", 2)
            sect, key, switch = PROFILE_KEYS[k]
            d = body.setdefault(sect, {})
            if v.lower() in OFF and switch:
                d[switch] = 0
            elif v.lower() in ("on",) and switch:
                d[switch] = 1
            else:
                d[key] = num(v, "profile")
                if switch:
                    d[switch] = 1
        pr = call(f"profiles/{name}", body, method="PUT")
        return out(pr, lambda d: profile_text(name, d, name == s["power"].get("current_profile")))
    usage("profile")


def cmd_switch(a, key, state_get, topic):
    if a:
        call("setting", {"key": key, "value": onoff(a[0], topic)})
    v = bool(state_get(call("state")))
    out({key: v}, f"{key}: {'on' if v else 'off'}")


# -- fan tables -----------------------------------------------------------------------------------
def table_name(s, t):
    p = s["power"]
    if t in (None, "current"):
        return p.get("current_table")
    if t not in p.get("table_names", []):
        fail(f"{T('error')}: unknown table {t} ({', '.join(p.get('table_names', []))})", 2)
    return t


def active_points(pts):
    res = []
    for i, x in enumerate(pts):
        if x["Duty"] > 100 or (i > 0 and x["UpT"] in (0, 255)):
            break
        res.append(x)
    return res


def table_text(name, t):
    lines = [f"{name}  separate CPU/GPU: {'on' if t.get('FanControlRespective') else 'off'}"]
    for kind in ("CPU", "GPU"):
        pts = active_points(t.get(kind) or [])
        if pts:
            lines.append(f"  {kind}: " + " ".join(f"{x['UpT']}/{x['DownT']}:{x['Duty']}" for x in pts))
        else:
            lines.append(f"  {kind}: —")
    return lines


def parse_points(args):
    pts = []
    for x in args:
        try:
            temps, duty = x.split(":")
            up, down = temps.split("/")
            pts.append({"UpT": int(up), "DownT": int(down), "Duty": int(duty)})
        except ValueError:
            usage("fan")
    if not 1 <= len(pts) <= 16:
        fail(f"{T('error')}: 1..16 levels", 2)
    for i in range(len(pts), 16):
        pts.append({"UpT": 255, "DownT": 255, "Duty": 255})
    for i, x in enumerate(pts):
        x["ID"] = i
    return pts


def cmd_fan(a):
    op = a[0] if a else "show"
    s = call("state")
    p = s["power"]
    if op == "list":
        used = {}
        for n, pr in s["profiles"].items():
            used.setdefault((pr.get("FAN") or {}).get("TableName"), []).append(n)
        rows = [{"table": t, "active": t == p.get("current_table"), "profiles": sorted(used.get(t, []))}
                for t in p.get("table_names", [])]
        return out(rows, lambda d: [f"{'*' if r['active'] else ' '} {r['table']:6} {', '.join(r['profiles'])}" for r in d])
    if op == "show":
        name = table_name(s, a[1] if a[1:] else None)
        t = call(f"table/{name}")
        return out(t, lambda d: table_text(name, d))
    if op == "reset" and a[1:]:
        name = table_name(s, a[1])
        t = call(f"table/{name}/restore", {})
        return out(t, lambda d: table_text(name, d))
    if op == "separate" and a[2:]:
        name = table_name(s, a[1])
        t = call(f"table/{name}", {"FanControlRespective": onoff(a[2], "fan")})
        return out(t, lambda d: table_text(name, d))
    if op == "set" and a[2:]:
        name = table_name(s, a[1])
        if a[2] == "--file":
            if not a[3:]:
                usage("fan")
            with open(a[3], encoding="utf-8-sig") as f:
                data = json.load(f)
            body = {k: data[k] for k in ("CPU", "GPU", "FanControlRespective") if k in data}
        elif a[2].lower() in ("cpu", "gpu"):
            body = {a[2].upper(): parse_points(a[3:])}
        else:
            usage("fan")
        t = call(f"table/{name}", body)
        return out(t, lambda d: table_text(name, d))
    usage("fan")


# -- battery --------------------------------------------------------------------------------------
def battery_text(b):
    mode = {v: k for k, v in BAT_MODES.items()}.get(b.get("health_mode"), b.get("health_mode"))
    lines = [f"mode {mode}, charge limit {b.get('limit_down')}–{b.get('limit_up')} %, {b.get('cycle_count')} cycles"]
    if b.get("typec_priority_support"):
        lines.append(f"Type-C priority: {'on' if b.get('typec_priority') else 'off'}")
    return lines


def cmd_battery(a):
    op = a[0] if a else "status"
    if op == "mode" and a[1:]:
        m = BAT_MODES.get(a[1], a[1])
        call("battery", {"health_mode": num(m, "battery")})
    elif op == "limit" and a[1:]:
        body = {"limit_up": num(a[1], "battery")}
        if a[2:]:
            body["limit_down"] = num(a[2], "battery")
        call("battery", body)
    elif op == "typec" and a[1:]:
        call("battery", {"typec_priority": onoff(a[1], "battery")})
    elif op != "status":
        usage("battery")
    out(call("state")["battery"], battery_text)


# -- keyboard -------------------------------------------------------------------------------------
def kb_text(k):
    lines = [f"kind {k.get('kind')}, power {'on' if k.get('power') else 'off'}"]
    e = k.get("effect")
    if e and e.get("fx") is not None:
        name = ((k.get("fx_effects") or {}).get(str(e.get("idx"))) or {}).get("name", e.get("idx"))
        lines.append(f"BetterRGB effect {name} ({e.get('idx')}), light {e.get('light')}, " +
                     " ".join(f"{a}={fx_val(b)}" for a, b in e["fx"].items() if not a.endswith("_i")))
        f = k.get("fx") or {}
        if f:
            lines.append(f"running, {f.get('fps')} of {f.get('target_fps')} frames per second" +
                         (f", needs {', '.join(f['needs'])}" if f.get("needs") else ""))
    elif e:
        name = (k.get("effects") or {}).get(str(e.get("idx")), e.get("idx"))
        lines.append(f"effect {name} ({e.get('idx')}), light {e.get('light')}, speed {e.get('speed')}, "
                     f"direction {e.get('direction')}, multicolour {'on' if e.get('circular') else 'off'}, "
                     f"colours {' '.join(hexrgb(c) for c in e.get('colors') or [])}")
    if "level" in k:
        lines.append(f"level {k['level']}")
    if k.get("device"):
        d = k["device"]
        lines.append(f"device {d.get('pid')} fw {d.get('fw')} type {d.get('type')}" +
                     (" (four-zone)" if k.get("four_zone") else ""))
    return lines


def fx_val(v):
    if isinstance(v, bool):
        return "on" if v else "off"
    if isinstance(v, list):
        return ",".join(hexrgb(c) for c in v)
    return str(v)


def fx_index(k, x):
    effects = k.get("fx_effects") or {}
    if str(x).isdigit() and str(x) in effects:
        return int(x)
    key = str(x).lower().replace("-", "").replace("_", "").replace(" ", "")
    for i, e in effects.items():
        if e["name"].lower().replace(" ", "") == key:
            return int(i)
    fail(f"{T('error')}: no BetterRGB effect {x} (uwccctl kb fx)", 2)


def fx_params(spec, pairs):
    out = {}
    kinds = {q["key"]: q for q in spec["params"]}
    for pair in pairs:
        if "=" not in pair:
            usage("kb")
        key, val = pair.split("=", 1)
        q = kinds.get(key)
        if not q:
            fail(f"{T('error')}: {key}: not a parameter of this effect ({', '.join(kinds)})", 2)
        if q["kind"] == "int":
            out[key] = num(val, "kb")
        elif q["kind"] == "bool":
            out[key] = val.lower() in ("on", "1", "yes", "true")
        elif q["kind"] == "choice":
            if val not in q["options"]:
                fail(f"{T('error')}: {key}: {' | '.join(q['options'])}", 2)
            out[key] = val
        else:
            out[key] = [rgb(c, "kb") for c in val.split(",")]
    return out


def fx_text(k):
    lines = []
    for i, e in (k.get("fx_effects") or {}).items():
        ps = " ".join(f"{q['key']}=" + ("|".join(q["options"]) if q["kind"] == "choice" else
                                        "on|off" if q["kind"] == "bool" else "RRGGBB,..." if q["kind"] == "colors" else
                                        f"{q['min']}-{q['max']}") for q in e["params"])
        needs = f"  [needs {', '.join(e['needs'])}]" if e["needs"] else ""
        lines.append(f"{i:>4} {e['name']:<17} {ps}{needs}")
    c = k.get("fx_config") or {}
    if c:
        b = c.get("bar") or {}
        lines.append(f"settings: fps_ac={c.get('fps_ac')} fps_battery={c.get('fps_battery')} "
                     f"transition={c.get('transition')} transition_ms={c.get('transition_ms')} "
                     f"bar={b.get('mode')} bar_direction={b.get('direction')} bar_start={hexrgb(b.get('start'))} "
                     f"bar_end={hexrgb(b.get('end'))} gains={'/'.join(str(g) for g in c.get('gains') or [])}")
    return lines


def effect_index(k, x):
    effects = k.get("effects") or {}
    if str(x).isdigit():
        if str(x) not in effects:
            fail(f"{T('error')}: no effect {x} (uwccctl kb effects)", 2)
        return int(x)
    key = str(x).lower().replace("-", "").replace("_", "").replace(" ", "")
    for i, n in effects.items():
        if n.lower().replace(" ", "") == key:
            return int(i)
    fail(f"{T('error')}: no effect {x} (uwccctl kb effects)", 2)


def cmd_kb(a):
    op = a[0] if a else "status"
    if op in ("on", "off"):
        call("keyboard/power", {"on": op == "on"})
    elif op == "level" and a[1:]:
        call("keyboard/level", {"level": num(a[1], "kb")})
    elif op == "effects":
        k = call("state")["keyboard"]
        bad = set(k.get("unsupported_effects") or [])
        soft = set(k.get("software_effects") or [])
        tryable = set(k.get("untested_effects") or [])
        rows = [{"id": int(i), "name": n, "supported": int(i) not in bad, "software": int(i) in soft,
                 "untested": int(i) in tryable} for i, n in (k.get("effects") or {}).items()]
        return out(rows, lambda d: [f"{r['id']:3} {r['name']:14}" + ("" if r["supported"] else
                                    " (not checked on this keyboard: --try)" if r["untested"] else " (not on this keyboard)") +
                                    (" (drawn by the service)" if r["software"] and r["supported"] else "") for r in d])
    elif op == "feedback" and len(a) == 3 and a[2] in ("yes", "no"):
        k = call("state")["keyboard"]
        r = call("keyboard/feedback", {"effect": effect_index(k, a[1]), "works": a[2] == "yes"})
        return out(r, lambda d: [f"{v['name']}: {'works' if v['works'] else 'does not work'}" for v in d.values()])
    elif op == "fx" and not a[1:]:
        return out(call("state")["keyboard"], fx_text)
    elif op == "fx":
        o, pos = opts(a[1:], {"light": True})
        if o is None or not pos:
            usage("kb")
        k = call("state")["keyboard"]
        idx = fx_index(k, pos[0])
        cur = k.get("effect") or {}
        params = dict(cur.get("fx") or {}) if cur.get("idx") == idx else {}
        params.update(fx_params(k["fx_effects"][str(idx)], pos[1:]))
        call("keyboard/effect", {"effect": idx, "light": num(o["light"], "kb") if "light" in o else cur.get("light", 4),
                                 "fx": {p: v for p, v in params.items() if not p.endswith("_i")}})
    elif op == "fx-config" and a[1:]:
        body, bar = {}, {}
        for pair in a[1:]:
            if "=" not in pair:
                usage("kb")
            key, val = pair.split("=", 1)
            if key in ("fps_ac", "fps_battery", "transition_ms"):
                body[key] = num(val, "kb")
            elif key == "transition":
                body[key] = val
            elif key == "bar":
                bar["mode"] = val
            elif key == "bar_direction":
                bar["direction"] = val
            elif key in ("bar_start", "bar_end"):
                bar[key[4:]] = rgb(val, "kb")
            else:
                usage("kb")
        if bar:
            body["bar"] = bar
        call("keyboard/fx/config", body)
        return out(call("state")["keyboard"], fx_text)
    elif op == "fx-calibrate" and a[1:]:
        act = a[1]
        if act not in ("start", "apply", "cancel", "reset") or (act == "apply" and len(a) < 3):
            usage("kb")
        r = call("keyboard/fx/calibrate", {"action": act, "observed": rgb(a[2], "kb") if act == "apply" else None})
        return out(r, lambda d: [f"gains {'/'.join(str(g) for g in d['gains'])} (per mille), "
                                 f"calibrating {'yes' if d['calibrating'] else 'no'}"])
    elif op == "effect" and a[1:]:
        o, pos = opts(a[1:], {"light": True, "speed": True, "dir": True, "color": True, "multi": False,
                              "no-multi": False, "text": True, "try": False})
        if o is None or len(pos) != 1:
            usage("kb")
        k = call("state")["keyboard"]
        cur = k.get("effect") or {}
        body = {"effect": effect_index(k, pos[0]), "light": cur.get("light", 4), "speed": cur.get("speed", 2),
                "direction": cur.get("direction", 0), "circular": bool(cur.get("circular"))}
        if cur.get("colors"):
            body["colors"] = cur["colors"]
        if "light" in o:
            body["light"] = num(o["light"], "kb")
        if "speed" in o:
            body["speed"] = num(o["speed"], "kb")
        if "dir" in o:
            body["direction"] = DIRECTIONS.get(o["dir"], None)
            if body["direction"] is None:
                body["direction"] = num(o["dir"], "kb")
        if "color" in o:
            body["colors"] = [rgb(c, "kb") for c in o["color"].split(",")]
        if o.get("multi"):
            body["circular"] = True
        if o.get("no-multi"):
            body["circular"] = False
        if "text" in o:
            body["alphabet"] = o["text"]
        if o.get("try"):
            body["untested"] = True             # an effect not checked on this keyboard type
        call("keyboard/effect", body)
    elif op != "status":
        usage("kb")
    out(call("state")["keyboard"], kb_text)


def cmd_lb(a):
    zones = ("hinge", "base", "logo")
    rest = list(a)
    zone = rest.pop(0) if rest and rest[0] in zones else "hinge"
    op = rest[0] if rest else "status"
    if op in ("on", "off"):
        call("lightbar", {"zone": zone, "power": op == "on"})
    elif op == "color" and rest[1:]:
        call("lightbar", {"zone": zone, "colors": [rgb(rest[1], "lb")], **({"effect": rest[2]} if rest[2:] else {})})
    elif op == "effect" and rest[1:]:
        call("lightbar", {"zone": zone, "effect": rest[1]})
    elif op == "light" and rest[1:]:
        call("lightbar", {"zone": zone, "light": num(rest[1], "lb")})
    elif op != "status":
        usage("lb")
    lb = call("state")["keyboard"].get("lightbar")
    if not lb:
        fail("no light bar", 1)
    out(lb, lambda d: [f"{z:6} {'on ' if v.get('power') else 'off'} {v.get('effect'):16} light {v.get('light')} "
                       f"speed {v.get('speed')} {' '.join(hexrgb(c) for c in v.get('colors') or [])}"
                       for z, v in d["zones"].items()])


# -- Control Center 3.0 / Clevo (experimental) -------------------------------------------------------
def clevo_text(c):
    if not c.get("present"):
        return f"Control Center 3.0 / Clevo: not found ({c.get('reason') or '-'})"
    st = c.get("state") or {}
    kb = st.get("kb") or {}
    lines = [f"Control Center 3.0 / Clevo (experimental) via {c.get('transport')}"
             + (f", EC {c['ec_version']}" if c.get("ec_version") else ""),
             f"commands: {'allowed' if c.get('writes') else 'off (uwccctl clevo writes on)'}, "
             f"restore at start: {'on' if c.get('restore') else 'off'}",
             "capabilities: " + (", ".join(k for k, v in (c.get("caps") or {}).items() if v) or "-")]
    for f in c.get("fans") or []:
        lines.append(f"  {f['fan']:5} {f['rpm']:5} rpm  {f['duty']:3}%  {f['temp'] if f['temp'] is not None else '-'} °C")
    lines.append(f"power mode: {st.get('power_mode', '-')}   fan mode: {st.get('fan_mode', '-')}"
                 f"   offset: {st.get('fan_offset', '-')}   (as last set here: the firmware does not report them)")
    for n, pts in (st.get("curve") or {}).items():
        lines.append(f"  curve {n}: " + "  ".join(f"{t}°C {d}%" for t, d in pts))
    if kb:
        lines.append("keyboard: " + ", ".join(f"{k} {hexrgb(v) if isinstance(v, list) else v}" for k, v in kb.items()))
    return lines


def cmd_clevo(a):
    op, rest = (a[0], a[1:]) if a else ("status", [])
    act = None
    if op in ("writes", "restore") and rest:
        call("setting", {"key": f"clevo_{op}", "value": onoff(rest[0], "clevo")})
    elif op == "power" and rest:
        act = {"action": "power_mode", "mode": rest[0]}
    elif op == "fan" and rest:
        if rest[0] == "offset" and rest[1:]:
            act = {"action": "fan_offset", "value": num(rest[1], "clevo")}
        elif rest[0] == "defaults":
            act = {"action": "fan_defaults"}
        elif rest[0] == "curve" and len(rest) >= 5:
            try:
                pts = [[int(x) for x in p.split(",")] for p in rest[2:5]]
            except ValueError:
                usage("clevo")
            act = {"action": "curve", "curves": {rest[1]: pts}}
        else:
            act = {"action": "fan_mode", "mode": rest[0]}
    elif op == "antidust":
        act = {"action": "anti_dust"}
    elif op == "kb" and rest:
        k, v = rest[0], rest[1:]
        if k in ("on", "off"):
            act = {"action": "kb_power", "on": k == "on"}
        elif k == "color" and v:
            act = {"action": "kb_color", "color": rgb(v[0], "clevo"), **({"zone": num(v[1], "clevo")} if v[1:] else {})}
        elif k == "brightness" and v:
            act = {"action": "kb_brightness", "value": num(v[0], "clevo")}
        elif k == "effect" and v:
            act = {"action": "kb_effect", "effect": v[0]}
        elif k == "sleep" and v:
            act = {"action": "kb_sleep", "seconds": num(v[0], "clevo")}
        elif k == "boot-effect" and v:
            act = {"action": "boot_effect", "off": not onoff(v[0], "clevo")}
        else:
            usage("clevo")
    elif op != "status":
        usage("clevo")
    out(call("clevo", act) if act else call("clevo"), clevo_text)


# -- settings, automation, app binding ------------------------------------------------------------
def all_settings(s):
    d = dict(s["settings"])
    d.update(s.get("automation") or {})
    d["super_performance"] = bool(s["power"].get("super_performance"))
    return d


def cmd_get(a):
    d = all_settings(call("state"))
    if a:
        if a[0] not in d:
            fail(f"{T('error')}: unknown key {a[0]}", 2)
        return out({a[0]: d[a[0]]}, f"{d[a[0]]}")
    out(d, lambda x: [f"{k:18} {v}" for k, v in x.items()])


def cmd_set(a):
    if len(a) != 2:
        usage("set")
    key, v = a
    if key not in SETTINGS:
        fail(f"{T('error')}: unknown key {key} (uwccctl help set)", 2)
    call("setting", {"key": key, "value": setting_value(key, v)})
    if key == "fan_manager":
        return out({key: v, "restarting": True}, f"{key}: {v} (the service restarts if it changed)")
    if key == "lightbar_trigger":
        return out({"ok": True}, "ok")
    d = all_settings(call("state"))
    v = d.get(key)
    out({key: v}, f"{key}: {MODE_BY_ID.get(v, v) if SETTINGS[key] == 'mode' and not isinstance(v, bool) else v}")


def cmd_apps(a):
    rules = call("state").get("app_binding") or []
    op = a[0] if a else "list"
    if op == "add" and len(a) == 3:
        m = MODES.get(a[2], None)
        m = num(a[2], "apps") if m is None else m
        rules = [r for r in rules if r["process"].lower() != a[1].lower()] + [{"process": a[1], "mode": m, "enabled": True}]
    elif op == "remove" and len(a) == 2:
        if not any(r["process"].lower() == a[1].lower() for r in rules):
            fail(f"{T('error')}: no rule for {a[1]}", 1)
        rules = [r for r in rules if r["process"].lower() != a[1].lower()]
    elif op in ("enable", "disable") and len(a) == 2:
        if not any(r["process"].lower() == a[1].lower() for r in rules):
            fail(f"{T('error')}: no rule for {a[1]}", 1)
        for r in rules:
            if r["process"].lower() == a[1].lower():
                r["enabled"] = op == "enable"
    elif op != "list":
        usage("apps")
    if op != "list":
        call("appbinding", {"rules": rules})
        rules = call("state").get("app_binding") or []
    out(rules, lambda d: [f"{'on ' if r['enabled'] else 'off'} {r['process']:24} {MODE_BY_ID.get(r['mode'], r['mode'])}"
                          for r in d] or ["no rules"])


# -- liquid cooler --------------------------------------------------------------------------------
LC_BOOL = ("smooth", "notify_flow", "flow_guard", "boost_fan", "boost_pump")
LC_IDLE = ("off_below", "off_after", "on_above", "on_after", "min_run")


def cmd_lc(a):
    op = a[0] if a else "status"
    if op == "status":
        lc = call("state")["liquid"]
        return out(lc, lambda d: T("lc") + " " + lc_line(d))
    if op == "scan":
        devs = call("lc/scan", {}, timeout=40)["devices"]
        return out(devs, lambda d: [f"  {x['address']}  {x['name']}  RSSI {x['rssi']}" for x in d] or T("lc_nothing"))
    if op == "connect" and a[1:]:
        call("lc/connect", {"address": a[1]}, timeout=70)
    elif op == "disconnect":
        call("lc/disconnect", {"forget": "--forget" in a})
    elif op == "mode" and a[1:]:
        call("lc/config", {"mode": a[1]})
    elif op == "manual" and a[2:]:
        call("lc/config", {"mode": "manual", "fan": num(a[1], "lc"), "pump": num(a[2], "lc")})
    elif op == "tiers" and a[1:]:
        tiers = []
        for x in a[1:]:
            try:
                below, fan, pump = (int(v) for v in x.split(":"))
            except ValueError:
                usage("lc")
            tiers.append({"below": below, "fan": fan, "pump": pump})
        call("lc/config", {"tiers": tiers})
    elif op == "set" and len(a) == 3:
        k, v = a[1], a[2]
        if k in LC_BOOL:
            val = onoff(v, "lc")
        elif k in ("delay_up", "delay_down"):
            val = num(v, "lc")
        elif k == "temp_source":
            val = v
        else:
            usage("lc")
        call("lc/config", {k: val})
    elif op == "idle" and a[1:]:
        pi = {"enabled": onoff(a[1], "lc")}
        for kv in a[2:]:
            k, eq, v = kv.partition("=")
            if not eq or k not in LC_IDLE:
                usage("lc")
            pi[k] = num(v, "lc")
        call("lc/config", {"pump_idle": pi})
    elif op == "rgb" and a[1:]:
        if a[1] == "off":
            call("lc/config", {"rgb": {"on": False}})
        else:
            body = {"on": True, "color": rgb(a[1], "lc")}
            if a[2:]:
                body["mode"] = a[2].replace("-", "_")
            call("lc/config", {"rgb": body})
    elif op == "prime":
        call("lc/prime", {"stop": a[1:2] == ["stop"]})
    elif op == "suspend":
        call("lc/suspend", {})
    else:
        usage("lc")
    lc = call("state")["liquid"]
    out(lc, lambda d: T("lc") + " " + lc_line(d))


# -- the rest -------------------------------------------------------------------------------------
def cmd_history(a):
    ranges = ("1m", "5m", "15m", "1h", "24h")
    fmts = ("csv", "csv-excel", "json")
    fmt = next((x for x in a if x in fmts), "json" if JSON else "csv")
    rng = next((x for x in a if x in ranges), "1h")
    dest = next((x for x in a if x not in fmts + ranges), None)
    data = call_raw(f"history/export?format={fmt}&range={rng}")
    if dest:
        with open(dest, "wb") as f:
            f.write(data)
        out({"file": os.path.abspath(dest)}, dest)
    else:
        sys.stdout.write(data.decode("utf-8-sig"))


def cmd_version(cmd, a):
    st = call("update/check", {}, timeout=40) if cmd == "update" or a[:1] == ["check"] else call("update")
    if cmd == "update" and a[:1] == ["install"]:
        if not st.get("can_install"):
            fail("Linux: download the release archive and run: sudo bash install.sh", 1)
        call("update/download", {})
        return out({"downloading": True}, "downloading; the Control Center tray app starts the installer when it is verified")
    if JSON:
        return out(st)
    print("open-uniwill-cc", st.get("version_full") or st.get("current"))
    if st.get("error"):
        print("update check:", st["error"])
    elif st.get("latest"):
        print("latest release:", st["latest"], "— newer, see " + str(st.get("url")) if st.get("newer") else "(up to date)")
    if st.get("newer") and not IS_WIN:
        print("install: download " + str(st.get("linux") or st.get("url")) + ", unpack it and run: sudo bash install.sh")


def cmd_report(a):
    def opt(k):
        return next((a[i + 1] for i, x in enumerate(a) if x == k and i + 1 < len(a)), "")
    flags = {"--private", "--sections"}
    dest = next((x for i, x in enumerate(a) if not x.startswith("--") and (i == 0 or a[i - 1] not in flags)), None)
    q = f"report?private={opt('--private')}" + (f"&sections={opt('--sections')}" if opt("--sections") else "") \
        + ("&full=1" if "--full" in a else "")
    req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/{q}", headers={"X-UWCC-Token": tok()})
    r = _open(req, 180)
    name = dest or r.headers.get("X-UWCC-Filename") or "uwcc-report.zip"
    with open(name, "wb") as f:
        f.write(r.read())
    out({"file": os.path.abspath(name)},
        [os.path.abspath(name), "Attach it to a GitHub issue (https://github.com/aspidovss/open-uniwill-cc/issues) "
                                "or send it to OUCC@aspidov.ru"])


def cmd_export(a):
    if not a or a[0] not in ("fans", "all"):
        usage("export")
    data = call_raw(f"export?what={a[0]}")
    if a[1:]:
        with open(a[1], "wb") as f:
            f.write(data)
        out({"file": os.path.abspath(a[1])}, a[1])
    else:
        sys.stdout.write(data.decode())


def cmd_import(a):
    if not a:
        usage("import")
    with open(a[0], encoding="utf-8-sig") as f:
        data = json.load(f)
    rest = [x for x in a[1:] if x != "--force"]
    sections = rest[0].split(",") if rest else ["fans", "profiles"]
    out(call("import", {"data": data, "sections": sections, "force": "--force" in a}))


def cmd_restart():
    import subprocess
    if IS_WIN:
        subprocess.run(["sc.exe", "stop", "uwccd"], check=False)
        time.sleep(3)
        sys.exit(subprocess.run(["sc.exe", "start", "uwccd"], check=False).returncode)
    sys.exit(subprocess.run(["systemctl", "restart", "uwccd.service"], check=False).returncode)


def cmd_ec_direct(a):
    ec = direct_ec()
    if a[:1] == ["read"] and a[1:]:
        addr = int(a[1], 16)
        n = int(a[2]) if a[2:] else 1
        vals = {f"0x{addr + i:04X}": ec.read(addr + i) for i in range(n)}
        out(vals, [f"{k} = 0x{v:02X}" for k, v in vals.items()])
    elif a[:1] == ["dump"] and a[1:]:
        base = int(a[1], 16)
        for row in range(0, 256, 16):
            print(f"{base + row:04X}: " + " ".join(f"{ec.read(base + row + i):02X}" for i in range(16)))
    else:
        usage("ec-direct")


def cmd_release():
    _pkg()
    from uwccd.nvram import Nvram
    ec = direct_ec()
    ec.set_bit(0x7C6, 2, False)   # RAM fan table off
    ec.set_bit(0x741, 0, False)   # AP not present
    nv = Nvram()
    nv.verify(ec.read(0x740))
    nv.set("ApExistFlag", 0)
    if nv.get("MemoryOverClockSupport") == 1 and nv.get("MemoryOverClockSwitch"):
        nv.set("MemoryOverClockSwitch", 0)     # SetFwVarsForUninstall: no RAM overclocking without the program
        print("RAM overclocking switched off (BIOS, next start)")
    print("fan control returned to the EC")


def cmd_help(a):
    topic = a[0] if a else None
    if topic in HELP:
        print(HELP[topic])
    else:
        print(__doc__)
        if not IS_WIN:
            print("Details: man uwccctl   (Russian: man -L ru uwccctl)")
        else:
            print("Details: uwccctl help COMMAND")


def main(a):
    global LANG, JSON
    for stream in (sys.stdout, sys.stderr):        # a console code page without "°" or "—" must not crash the tool
        try:
            stream.reconfigure(errors="replace")
        except (AttributeError, ValueError):
            pass
    if "--json" in a:
        JSON = True
        a = [x for x in a if x != "--json"]
    if not a or a[0] in ("-h", "--help", "help"):
        return cmd_help(a[1:])
    cmd, rest = a[0], a[1:]
    if rest[:1] in (["-h"], ["--help"]):
        return cmd_help([cmd])
    if cmd == "restart":
        return cmd_restart()
    if cmd == "ec-direct":
        return cmd_ec_direct(rest)
    if cmd == "driver-verify":                  # check an OEM driver package without the service (installers)
        _pkg()
        from uwccd.drivercheck import main as verify_main
        sys.exit(verify_main(rest))
    if cmd == "release":
        return cmd_release()
    if cmd in ("status", "lc", "lang"):
        LANG = call("state")["settings"].get("lang", "en")
    simple = {
        "status": lambda: cmd_status(),
        "monitor": lambda: cmd_monitor(rest),
        "mode": lambda: cmd_mode(rest),
        "profile": lambda: cmd_profile(rest),
        "boost": lambda: (call("fanboost", {"on": onoff(rest[0], "boost")}) if rest else None,
                          out({"fan_boost": call("state")["power"]["fan_boost"]},
                              lambda d: f"FanBoost: {'on' if d['fan_boost'] else 'off'}")),
        "super": lambda: cmd_switch(rest, "super_performance", lambda s: s["power"].get("super_performance"), "super"),
        "ramoc": lambda: cmd_ramoc(rest),
        "fan": lambda: cmd_fan(rest),
        "battery": lambda: cmd_battery(rest),
        "kb": lambda: cmd_kb(rest),
        "lb": lambda: cmd_lb(rest),
        "clevo": lambda: cmd_clevo(rest),
        "get": lambda: cmd_get(rest),
        "set": lambda: cmd_set(rest),
        "apps": lambda: cmd_apps(rest),
        "restore": lambda: cmd_restore(rest),
        "lc": lambda: cmd_lc(rest),
        "history": lambda: cmd_history(rest),
        "version": lambda: cmd_version(cmd, rest),
        "update": lambda: cmd_version(cmd, rest),
        "report": lambda: cmd_report(rest),
        "export": lambda: cmd_export(rest),
        "import": lambda: cmd_import(rest),
        "lang": lambda: cmd_lang(rest),
        "debug": lambda: cmd_switch(rest, "debug", lambda s: s["settings"].get("debug"), "debug"),
        "lighting": lambda: out(call("lighting/devices")),
        "nvram": lambda: out(call("nvram")),
        "resume": lambda: (call("resume", {}), out({"ok": True}, "ok")),
        "ec": lambda: cmd_ec(rest),
        "driver": lambda: cmd_driver(rest),
    }
    if cmd not in simple:
        usage(None)
    simple[cmd]()


def cmd_ramoc(a):
    if a:
        call("setting", {"key": "mem_oc", "value": onoff(a[0], "ramoc")})
    st = call("state")["settings"]
    d = {"supported": bool(st.get("mem_oc_support")), "mem_oc": bool(st.get("mem_oc")),
         "pending_reboot": bool(st.get("mem_oc_pending"))}
    out(d, lambda x: "RAM overclocking: not supported on this laptop" if not x["supported"] else
        f"RAM overclocking: {'on' if x['mem_oc'] else 'off'}" + (" (applies after a reboot)" if x["pending_reboot"] else ""))


def cmd_restore(a):
    if "--yes" not in a:
        fail("This resets every profile and fan table to factory values. Run: uwccctl restore --yes", 2)
    call("restore", {})
    out({"ok": True}, "factory profiles and fan tables restored")


def cmd_lang(a):
    global LANG
    if a:
        if a[0] not in ("en", "ru"):
            usage("lang")
        call("setting", {"key": "lang", "value": a[0]})
        LANG = a[0]
    out({"lang": LANG}, T("lang_set"))


def driver_text(d):
    names = {"oem": "OEM driver (UWACPIDriver)", "wmi": "WMI (beta)", "none": "none", "native": "kernel module / acpi_call"}
    lines = [f"EC path      : {names.get(d.get('active'), d.get('active'))}  (setting: {d.get('setting')})"]
    if d.get("edition") in ("free", "full"):
        lines.append("Build        : " + ("free — no OEM driver inside, distributed freely" if d["edition"] == "free"
                                         else "non-free — OEM driver UWACPIDriver included"))
    pkg = d.get("driver_package")
    lines.append(f"Driver files : {pkg['dir'] if pkg else 'none'}  (place for the OEM driver: {d.get('driver_dir')})")
    if d.get("reason"):
        lines.append(f"Reason       : {d['reason']}")
    if d.get("oem_present") is not None:
        drv = d.get("driver") or {}
        lines.append(f"OEM driver   : {'present' if d['oem_present'] else 'NOT found'}"
                     + (f", version {drv.get('version')}" if drv.get("version") else ""))
    lines.append(f"WMI warning  : {'accepted' if d.get('consent') else 'not accepted'}")
    if d.get("active") == "wmi":
        lines.append("Features     : " + ", ".join(f"{k}={v}" for k, v in d.get("features", {}).items()))
        st = d.get("stats") or {}
        if st:
            lines.append(f"EC accesses  : {st.get('reads')} reads ({st.get('cached')} cached), "
                         f"{st.get('writes')} writes ({st.get('skipped')} skipped)")
    plat = d.get("platform") or {}
    if plat:
        lines.append(f"Platform     : {plat.get('name')} — {plat.get('status')} ({plat.get('source')})")
    m = d.get("monitoring") or {}
    if m:
        lines.append(f"Monitoring   : {m.get('level')}")
    adm = d.get("admin") or {}
    lines.append("Settings     : " + (f"unlocked ({adm.get('remaining', 0) // 60} min left)" if adm.get("unlocked")
                                     else "locked (uwccctl ec unlock as administrator)"))
    lines.append(f"Docs         : {d.get('docs')}")
    return lines


def cmd_driver(a):
    op = a[0] if a else "status"
    if op == "status":
        return out(call("ec-access"), driver_text)
    if op == "use" and a[1:]:
        body = {"backend": a[1]}
        if "--accept-risks" in a:
            body["consent"] = call("ec-access")["consent_version"]
        r = call("ec-access", body)
        return out(r, lambda d: driver_text(d) + (["The service is restarting…"] if d.get("restarting") else []))
    if op == "unlock":
        if not admin_tok():
            fail("Administrator rights needed: run as administrator (Windows) or with sudo (Linux).", 3)
        mins = int(a[1]) if a[1:] and a[1].isdigit() else 10
        r = call("admin/unlock", {"seconds": mins * 60})
        return out(r, f"EC Manager unlocked for {(r['remaining'] + 59) // 60} min")
    if op == "lock":
        return out(call("admin/lock", {}), "EC Manager locked")
    if op in ("check-driver", "fetch-driver", "install-driver"):
        def check_lines(c):
            if not c:
                return ["no driver package"]
            return [f"[{x['status'].upper():4}] {x['id']}: {x['detail']}" for x in c.get("checks", [])] + \
                [f"result: {c.get('level')}"]
        if op == "fetch-driver":
            r = call("ec-access/fetch-driver", {}, timeout=120)
            out(r, lambda d: [f"copied {', '.join(d['files'])}", f"  from {d['from']}", f"  to   {d['to']}"]
                + check_lines((d.get("package") or {}).get("check")))
            return
        if op == "check-driver":
            pkg = call("ec-access").get("driver_package")
            return out(pkg or {}, lambda d: ([f"package: {d['dir']}"] if d else []) + check_lines((d or {}).get("check")))
        r = call("ec-access/install-driver", {"accept_risks": "--accept-risks" in a}, timeout=180)
        if r.get("risk_required"):
            out(r, lambda d: check_lines(d.get("check")) + ["", "Not installed: " + d.get("error", ""),
                                                        "Add --accept-risks if you still want to use this driver."])
            sys.exit(1)
        return out(r, lambda d: check_lines(d.get("check")) +
                   [f"OEM driver installed from {d.get('dir')}" + (" (reboot required)" if d.get("reboot") else "")]
                   + (["The service is restarting…"] if d.get("restarting") else []))
    if op == "monitor":
        if len(a) < 3 or a[1] not in ("oem", "wmi", "all"):
            usage("driver")
        call("setting", {"key": f"monitor_off_{a[1]}", "value": not onoff(a[2], "driver")})
        m = call("ec-access")["monitoring"]
        return out(m, f"monitoring: {m['level']} (off for OEM: {m['off_oem']}, WMI: {m['off_wmi']}, all: {m['off_all']})")
    if op == "platform":
        sub = a[1] if a[1:] else "show"
        if sub == "show":
            return out(call("platform"), lambda d: [
                f"Profile : {d['name']} ({d['id']})", f"Status  : {d['status']}, {d['source']}"
                + (" (replaces the built-in one)" if d.get("modified") else ""),
                f"Project : {d.get('project')}"] + [f"Note    : {n}" for n in ((d.get('notes') or {}).get(LANG) or (d.get('notes') or {}).get('en') or [])])
        if sub == "export" and a[2:]:
            with open(a[2], "w", encoding="utf-8") as f:
                json.dump(call("platform")["profile"], f, indent=2, ensure_ascii=False)
            return out({"file": os.path.abspath(a[2])}, a[2])
        if sub == "import" and a[2:]:
            with open(a[2], encoding="utf-8-sig") as f:
                prof = json.load(f)
            return out(call("platform/import", {"profile": prof}), lambda d: f"profile {d['id']} saved ({d['status']})"
                       + ("; restart the service to apply" if d.get("restart_needed") else ""))
        if sub in ("reset", "apply-draft"):
            return out(call("platform/" + sub, {}), lambda d: f"profile: {d['id']} ({d['status']}, {d['source']})"
                       + ("; restart the service to apply" if d.get("restart_needed") else ""))
        usage("driver")
    if op == "selfcheck":
        stage = 2 if "2" in a[1:] else 1
        call("selfcheck", {"stage": stage})
        while True:
            time.sleep(1)
            r = call("selfcheck")
            if not r.get("running"):
                break
        res = r.get("result") or {}
        if "--export" in a:
            i = a.index("--export")
            if a[i + 1:]:
                with open(a[i + 1], "w", encoding="utf-8") as f:
                    json.dump(call("selfcheck/export"), f, indent=2, ensure_ascii=False)
        mark = {"ok": "OK  ", "warn": "WARN", "fail": "FAIL", "skip": "skip", "unknown": "?   "}
        return out(res, lambda d: [f"[{mark.get(i['status'], i['status'])}] {i['name']}: {i['detail']}" for i in d.get("items", [])]
                   + (["", "Not clear:"] + [f"  - {u}" for u in d.get("unknowns", [])] if d.get("unknowns") else [])
                   + (["", "Error: " + d["error"]] if d.get("error") else []))
    if op == "test":
        return out(call("ec-access/test", {}), lambda d: [
            f"path {d['path']}, project {d['project']} ({'tested platform' if d['tested_platform'] else 'NOT a tested platform'}), "
            f"{d['ms_per_read']} ms per read"] + [f"  {r['addr']} = 0x{r['value']:02X}" for r in d["reads"]])
    if op == "config" and a[1:]:
        sub = a[1]
        if sub == "export" and a[2:]:
            cfg = call("ec-access/config")["effective"]
            with open(a[2], "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2, ensure_ascii=False)
            return out({"file": os.path.abspath(a[2])}, a[2])
        if sub == "import" and a[2:]:
            with open(a[2], encoding="utf-8-sig") as f:
                cfg = json.load(f)
            return out(call("ec-access/config", {"config": cfg}), lambda d: "imported" +
                       ("; restart the service to apply poll / limits changes" if d.get("restart_needed") else ""))
        if sub == "reset":
            call("ec-access/config", {"reset": True})
            return out({"ok": True}, "factory WMI settings restored")
    usage("driver")


def cmd_ec(a):
    if a[:1] != ["read"]:                       # `uwccctl ec ...` = EC Manager (`uwccctl driver ...`)
        return cmd_driver(a)
    if not a[1:]:
        usage("ec")
    r = call(f"ec/{int(a[1], 16):x}")
    out(r, f"0x{r['addr']:04X} = 0x{r['value']:02X} ({r['value']})")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except BrokenPipeError:                      # uwccctl ... | head
        try:
            sys.stdout = open(os.devnull, "w")
        except OSError:
            pass
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
