#!/usr/bin/env python3
"""Open the Control Center window (app-style browser window, WebKitGTK if available)."""
import os
import shutil
import subprocess
import sys

PORT = int(os.environ.get("UWCC_PORT", "47321"))
TOKEN_FILE = os.environ.get("UWCC_TOKEN_FILE", "/run/uwcc/token")


MSG = {
    "en": {"access": "No access to the Control Center service.\n"
                     "Your user must be in the uwcc group (log out and in again after installation).",
           "down": "The Control Center service is not running (sudo systemctl start uwccd)."},
    "ru": {"access": "Нет доступа к службе Control Center.\n"
                     "Ваш пользователь должен входить в группу uwcc (выполните вход заново после установки).",
           "down": "Служба Control Center не запущена (sudo systemctl start uwccd)."},
}


def _lang():
    loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return "ru" if loc.lower().startswith("ru") else "en"


def token():
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip()
    except PermissionError:
        msg = MSG[_lang()]["access"]
    except FileNotFoundError:
        msg = MSG[_lang()]["down"]
    if shutil.which("zenity"):
        subprocess.run(["zenity", "--error", "--title=Control Center", "--text=" + msg])
    print(msg, file=sys.stderr)
    sys.exit(1)


def webkit_window(url):
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        try:
            gi.require_version("WebKit2", "4.1")
        except ValueError:
            gi.require_version("WebKit2", "4.0")
        from gi.repository import Gtk, WebKit2
    except (ImportError, ValueError):
        return False
    win = Gtk.Window(title="Control Center")
    win.set_default_size(1280, 820)
    icon = "/opt/uwcc/uwccd/web/icon.svg"
    if os.path.exists(icon):
        win.set_icon_from_file(icon)
    view = WebKit2.WebView()
    view.get_settings().set_enable_developer_extras(False)
    view.load_uri(url)
    win.add(view)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return True


def main():
    url = f"http://127.0.0.1:{PORT}/#token={token()}"
    if os.environ.get("UWCC_BROWSER") != "1" and webkit_window(url):
        return
    for b in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "microsoft-edge", "brave-browser"):
        if shutil.which(b):
            subprocess.Popen([b, f"--app={url}", "--class=uwcc", "--window-size=1280,820"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
