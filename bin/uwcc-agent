#!/usr/bin/env python3
"""User-session agent: OSD notifications, touchpad on/off, Fn launch key, input for the BetterRGB effects.

Runs from ~/.config/autostart. Listens to the service event stream (SSE).
BetterRGB effects: while the running effect needs it, the agent sends a small picture of the screen (X11 only) and
the master volume (pactl) — key presses are read by the service itself. Nothing is stored.
"""
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request

PORT = int(os.environ.get("UWCC_PORT", "47321"))
TOKEN_FILE = "/run/uwcc/token"
