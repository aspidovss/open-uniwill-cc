LANG = {"v": "en"}


def T(key, *a):
    s = TEXT.get(LANG["v"], TEXT["en"]).get(key) or TEXT["en"][key]
    return s.format(*a) if a else s


ICONS = {0: "power-profile-power-saver-symbolic", 1: "power-profile-balanced-symbolic", 2: "power-profile-performance-symbolic"}
_last_id = {"id": None}


def notify(title, body="", icon="preferences-system-symbolic", critical=False):
    if not shutil.which("notify-send"):
        return
    if critical:      # stays on screen, does not replace the OSD bubble
        cmd = ["notify-send", "-a", "Control Center", "-i", icon, "-u", "critical", title]
        if body:
            cmd.append(body)
        subprocess.run(cmd, check=False, timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    cmd = ["notify-send", "-a", "Control Center", "-i", icon, "-t", "1500", "-h", "string:x-canonical-private-synchronous:uwcc",
           "-p", title]
    if body:
        cmd.append(body)
    if _last_id["id"]:
        cmd[1:1] = ["-r", _last_id["id"]]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout.strip()
        if out.isdigit():
            _last_id["id"] = out
    except (OSError, subprocess.SubprocessError):
        pass


def set_touchpad(on):
    if shutil.which("gsettings"):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.peripherals.touchpad", "send-events",
                        "enabled" if on else "disabled"], check=False)
    if os.environ.get("XDG_SESSION_TYPE") == "x11" and shutil.which("xinput"):
        out = subprocess.run(["xinput", "list", "--name-only"], capture_output=True, text=True).stdout
        for name in out.splitlines():
            if "touchpad" in name.lower():
                subprocess.run(["xinput", "enable" if on else "disable", name], check=False)


def token():
    with open(TOKEN_FILE) as f:
        return f.read().strip()


def handle(ev, osd_enabled):
    t, d = ev.get("type"), ev.get("data") or {}
    if t == "touchpad":
        set_touchpad(d.get("enabled", True))
        if osd_enabled:
            notify(T("touch_on") if d.get("enabled") else T("touch_off"), icon="input-touchpad-symbolic")
    elif t == "lc":
        e = d.get("event")
        if e == "flow_fault":                      # always shown, independent of the OSD switch
            notify(T("lc_flow"), T("lc_flow_body") + "\n" + T("lc_guard"), icon="dialog-warning", critical=True)
        elif e == "disconnected" and d.get("unexpected"):
            notify(T("lc_lost"), T("lc_lost_body"), icon="bluetooth-disconnected-symbolic")
        elif not osd_enabled:
            pass
        elif e == "connected":
            notify(T("lc_again") if d.get("again") else T("lc_conn"), d.get("name", ""), icon="bluetooth-active-symbolic")
        elif e == "boost":
            notify(T("lc_fan_boost" if d.get("which") == "fan" else "lc_pump_boost", T("on" if d.get("on") else "off")),
                   icon="weather-windy-symbolic")
        elif e == "prime_done":
            notify(T("lc_primed"), icon="emblem-ok-symbolic")
    elif t == "overheat":                          # always shown
        notify(T("hot_" + d.get("sensor", "cpu"), d.get("temp")),
               T("hot_body_boost" if d.get("boost") else "hot_body", d.get("limit")), icon="dialog-warning", critical=True)
    elif t == "overheat_boost":
        notify(T("hot_boost"), T("hot_boost_body"), icon="weather-windy-symbolic", critical=True)
    elif not osd_enabled:
        pass
    elif t == "mode" and d.get("osd"):
        m = d.get("mode")
        title = T("mode3", (d.get("slot") or 0) + 1) if m == 3 else (T(f"mode{m}") if m in (0, 1, 2) else "")
        notify(title, icon=ICONS.get(m, "preferences-system-symbolic"))
    elif t == "fanboost" and d.get("osd"):
        notify(T("boost_on" if d.get("on") else "boost_off"), icon="weather-windy-symbolic")
    elif t == "setting" and d.get("osd"):
        if "winkey_lock" in d:
            notify(T("win_locked" if d["winkey_lock"] else "win_unlocked"), icon="input-keyboard-symbolic")
        if "fn_lock" in d:
            notify("Fn Lock" if d["fn_lock"] else "Fn UnLock", icon="input-keyboard-symbolic")
    elif t == "kb_level" and d.get("osd"):
        notify(T("kb_level", d.get("level", 0)), icon="keyboard-brightness-symbolic")
    elif t == "reboot_required":
        notify(T("reboot"), T("reboot_body"))
    if t == "launch":
        subprocess.Popen(["uwcc"])


# ------------------------------------------------------------------ BetterRGB effects: input from this session
SCREEN_W, SCREEN_H = 64, 24


class X11Screen:
    """the root window sampled on a SCREEN_W x SCREEN_H grid: one 1-pixel strip per output row (XGetImage)"""

    def __init__(self):
        import ctypes
        import ctypes.util
        lib = ctypes.util.find_library("X11")
        if not lib or os.environ.get("XDG_SESSION_TYPE") == "wayland" or not os.environ.get("DISPLAY"):
            raise OSError("screen ambient needs an X11 session")
        x = ctypes.cdll.LoadLibrary(lib)
        x.XOpenDisplay.restype = ctypes.c_void_p
        x.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x.XDefaultRootWindow.restype = ctypes.c_ulong
        x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        x.XDefaultScreen.argtypes = [ctypes.c_void_p]
        x.XDisplayWidth.argtypes = x.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]

        class XImage(ctypes.Structure):
            _fields_ = [("width", ctypes.c_int), ("height", ctypes.c_int), ("xoffset", ctypes.c_int),
                        ("format", ctypes.c_int), ("data", ctypes.c_void_p), ("byte_order", ctypes.c_int),
                        ("bitmap_unit", ctypes.c_int), ("bitmap_bit_order", ctypes.c_int), ("bitmap_pad", ctypes.c_int),
                        ("depth", ctypes.c_int), ("bytes_per_line", ctypes.c_int), ("bits_per_pixel", ctypes.c_int)]
        x.XGetImage.restype = ctypes.POINTER(XImage)
        x.XGetImage.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint,
                                ctypes.c_uint, ctypes.c_ulong, ctypes.c_int]
        x.XFree.argtypes = [ctypes.c_void_p]
        self.ct, self.x = ctypes, x
        self.dpy = x.XOpenDisplay(None)
        if not self.dpy:
            raise OSError("cannot open the X display")
        self.root = x.XDefaultRootWindow(self.dpy)
        scr = x.XDefaultScreen(self.dpy)
        self.w, self.h = x.XDisplayWidth(self.dpy, scr), x.XDisplayHeight(self.dpy, scr)

    def grab(self):
        import base64
        out = bytearray()
        for row in range(SCREEN_H):
            y = int((row + 0.5) * self.h / SCREEN_H)
            img = self.x.XGetImage(self.dpy, self.root, 0, y, self.w, 1, 0xFFFFFFFF, 2)      # ZPixmap
            if not img:
                return None
            im = img.contents
            line = self.ct.string_at(im.data, im.bytes_per_line) if im.bits_per_pixel == 32 else None
            self.x.XFree(im.data)
            self.x.XFree(img)
            if line is None:
                return None
            for col in range(SCREEN_W):
                o = int((col + 0.5) * self.w / SCREEN_W) * 4
                out += bytes((line[o + 2], line[o + 1], line[o]))       # BGRX -> RGB
        return {"w": SCREEN_W, "h": SCREEN_H, "rgb": base64.b64encode(bytes(out)).decode()}


def master_volume():
    """0..1 of the default output (pactl, PipeWire or PulseAudio); 0 when muted"""
    try:
        mute = subprocess.run(["pactl", "get-sink-mute", "@DEFAULT_SINK@"], capture_output=True, text=True, timeout=2).stdout
        if "yes" in mute.lower():
            return 0.0
        out = subprocess.run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"], capture_output=True, text=True, timeout=2).stdout
        pct = [int(p.strip().rstrip("%")) for p in out.split("/") if p.strip().endswith("%")]
        return min(1.0, pct[0] / 100.0) if pct else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def fx_loop():
    needs, asked = [], 0.0
    screen, failed, next_vol = None, 0.0, 0.0
    while True:
        now = time.monotonic()
        body = {}
        if "screen" in needs and now > failed:
            try:
                screen = screen or X11Screen()
                shot = screen.grab()
                if shot:
                    body["screen"] = shot
            except Exception as e:  # noqa: BLE001
                print("uwcc-agent: screen ambient:", e, file=sys.stderr)
                screen, failed = None, now + 60
        if "volume" in needs and now >= next_vol and shutil.which("pactl"):
            next_vol = now + 0.3
            v = master_volume()
            if v is not None:
                body["metrics"] = {"volume": v}
        if body or now - asked > 2.0:
            try:
                req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/keyboard/fx/input", method="POST",
                                             data=json.dumps(body).encode(),
                                             headers={"X-UWCC-Token": token(), "Content-Type": "application/json"})
                needs = json.load(urllib.request.urlopen(req, timeout=3)).get("needs") or []
            except Exception:  # noqa: BLE001
                needs = []
            asked = now
        time.sleep(1 / 15.0 if ("screen" in needs or "volume" in needs) else 2.0)


def _service_answers(timeout=3):
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/state", headers={"X-UWCC-Token": token()})
        urllib.request.urlopen(req, timeout=timeout).read()
        return True
    except Exception:  # noqa: BLE001
        return False


def offer_restart():
    """After a minute without the service: a notification with a "Restart the service" button. systemctl asks polkit;
    the rule /etc/polkit-1/rules.d/50-uwcc.rules lets members of group uwcc restart uwccd without a password."""
    if not shutil.which("notify-send"):
        return
    try:
        has_actions = "--action" in subprocess.run(["notify-send", "--help"], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        has_actions = False
    if not has_actions:              # old libnotify: just tell the command
        notify(T("svc_down"), T("svc_down_body") + "\nsudo systemctl restart uwccd", icon="dialog-warning", critical=True)
        return
    try:
        r = subprocess.run(["notify-send", "-a", "Control Center", "-i", "dialog-warning", "-u", "critical", "--wait",
                            f"--action=restart={T('svc_restart')}", T("svc_down"), T("svc_down_body")],
                           capture_output=True, text=True, timeout=3600)
    except (OSError, subprocess.SubprocessError):
        return
    if r.stdout.strip() != "restart":
        return
    subprocess.run(["systemctl", "restart", "uwccd.service"], check=False, timeout=120)
    for _ in range(45):
        time.sleep(1)
        if _service_answers():
            notify(T("svc_restarted"), icon="emblem-ok-symbolic")
            return
    notify(T("svc_fail"), T("svc_fail_body"), icon="dialog-error", critical=True)


def main():
    import threading
    threading.Thread(target=fx_loop, daemon=True, name="fx").start()
    osd_enabled = True
    last_state = 0
    offline = {"since": None, "offered": False}
    while True:
        try:
            tok = token()
            if time.time() - last_state > 0:
                req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/state", headers={"X-UWCC-Token": tok})
                st = json.load(urllib.request.urlopen(req, timeout=10))
                osd_enabled = st["settings"].get("osd", True)
                LANG["v"] = st["settings"].get("lang", "en")
                set_touchpad(st["settings"].get("touchpad_enabled", True))
                last_state = time.time()
            offline.update(since=None, offered=False)
            req = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/events?token={tok}")
            with urllib.request.urlopen(req, timeout=60) as r:
                for raw in r:
                    line = raw.decode(errors="ignore").strip()
                    if not line.startswith("data:"):
                        continue
                    ev = json.loads(line[5:])
                    if ev.get("type") == "monitor":
                        continue
                    if ev.get("type") == "status":
                        try:
                            req2 = urllib.request.Request(f"http://127.0.0.1:{PORT}/api/state", headers={"X-UWCC-Token": tok})
                            st2 = json.load(urllib.request.urlopen(req2, timeout=10))["settings"]
                            osd_enabled = st2.get("osd", True)
                            LANG["v"] = st2.get("lang", "en")
                        except Exception:  # noqa: BLE001
                            pass
                        continue
                    handle(ev, osd_enabled)
        except PermissionError:
            print("uwcc-agent: no access to /run/uwcc/token (log in again after installation)", file=sys.stderr)
            time.sleep(60)
        except Exception as e:  # noqa: BLE001
            print("uwcc-agent:", e, file=sys.stderr)
            offline["since"] = offline["since"] or time.time()
            if time.time() - offline["since"] >= 60 and not offline["offered"]:
                offline["offered"] = True
                threading.Thread(target=offer_restart, daemon=True).start()
            time.sleep(3)


if __name__ == "__main__":
    main()
